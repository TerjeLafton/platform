package templates

import (
	"fmt"

	"github.com/terjelafton/platform/apps/web/internal/templates/ui"
	todov1 "github.com/terjelafton/platform/libs/proto-stubs/todo/v1"
)

templ ListSettingsPage(userID string, list *todov1.List, members []*todov1.ListMember) {
	@Layout("Settings — " + list.Title) {
		@ui.Navbar(userID) {
			<form method="POST" action="/logout">
				<button type="submit" class="text-sm text-text-secondary hover:text-text-primary cursor-pointer">Logout</button>
			</form>
		}
		@ui.PageNarrow() {
			<div class="mb-6">
				<a href={ templ.SafeURL(fmt.Sprintf("/todo/lists/%s", list.Id)) } class="text-sm text-link hover:underline">&larr; Back to list</a>
			</div>
			<h1 class="mb-8 text-2xl font-bold">List Settings</h1>
			// Rename section
			<div class="mb-8">
				<h2 class="mb-3 text-lg font-semibold">Name</h2>
				<form
					method="POST"
					action={ templ.SafeURL(fmt.Sprintf("/todo/lists/%s/title", list.Id)) }
					class="flex gap-2"
				>
					<input
						type="text"
						name="title"
						value={ list.Title }
						required
						class="flex-1 rounded border bg-input-bg border-input-border px-3 py-2 text-sm text-text-primary focus:border-brand focus:outline-none"
					/>
					@ui.Button("Save")
				</form>
			</div>
			// Members section
			<div class="mb-8">
				<h2 class="mb-3 text-lg font-semibold">Members</h2>
				<form
					hx-post={ fmt.Sprintf("/todo/lists/%s/members", list.Id) }
					hx-target="#members-list"
					hx-swap="beforeend"
					hx-on::after-request="if(event.detail.successful) this.reset()"
					class="mb-4 flex gap-2"
				>
					<input
						type="email"
						name="email"
						placeholder="Email address..."
						required
						class="flex-1 rounded border bg-input-bg border-input-border px-3 py-2 text-sm text-text-primary focus:border-brand focus:outline-none placeholder:text-text-muted"
					/>
					@ui.Button("Share")
				</form>
				<div id="members-list" class="space-y-2">
					for _, member := range members {
						@MemberRow(list.Id, member)
					}
				</div>
				if len(members) == 0 {
					<p class="py-4 text-center text-text-muted">Not shared with anyone yet.</p>
				}
			</div>
			// Danger zone
			<div class="rounded-lg border border-error-border bg-error-bg p-5">
				<h2 class="mb-2 text-lg font-semibold text-error-text">Danger Zone</h2>
				<p class="mb-4 text-sm text-text-secondary">Deleting this list will remove it for all members.</p>
				<button
					hx-delete={ fmt.Sprintf("/todo/lists/%s", list.Id) }
					hx-confirm="Are you sure you want to delete this list? This cannot be undone."
					hx-on::after-request="if(event.detail.successful) window.location.href='/todo'"
					class="rounded bg-danger px-4 py-2 text-sm font-medium text-white hover:opacity-90 cursor-pointer"
				>
					Delete List
				</button>
			</div>
		}
	}
}

templ MemberRow(listID string, member *todov1.ListMember) {
	<div id={ fmt.Sprintf("member-%s", member.UserId) } class="flex items-center justify-between rounded border border-border-subtle bg-surface px-4 py-3">
		<div>
			<span class="text-sm font-medium text-text-primary">{ member.Name }</span>
			<span class="ml-2 text-sm text-text-muted">{ member.Email }</span>
		</div>
		<button
			hx-delete={ fmt.Sprintf("/todo/lists/%s/members/%s", listID, member.UserId) }
			hx-target={ fmt.Sprintf("#member-%s", member.UserId) }
			hx-swap="outerHTML"
			class="text-sm text-delete hover:text-delete-hover cursor-pointer"
		>
			Remove
		</button>
	</div>
}
