package templates

import (
	"fmt"

	"github.com/terjelafton/platform/apps/web/internal/templates/ui"
	todov1 "github.com/terjelafton/platform/libs/proto-stubs/todo/v1"
)

templ ListsPage(userID string, lists []*todov1.List) {
	@Layout("Lists") {
		@ui.Navbar(userID) {
			<form method="POST" action="/logout">
				<button type="submit" class="text-sm text-text-secondary hover:text-text-primary cursor-pointer">Logout</button>
			</form>
		}
		@ui.PageWide() {
			<div class="mb-8 flex items-center justify-between">
				<h1 class="text-2xl font-bold">Lists</h1>
				<div class="flex items-center gap-4">
					<a href="/templates" class="text-sm text-link hover:underline">Templates</a>
					<a href="/todo/new" class="rounded bg-brand px-4 py-2 text-sm font-medium text-brand-text hover:bg-brand-hover">New List</a>
				</div>
			</div>
			if len(lists) == 0 {
				<p class="py-8 text-center text-text-muted">No lists yet. Create one above!</p>
			} else {
				<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
					for _, list := range lists {
						@ListCard(list)
					}
				</div>
			}
		}
	}
}

templ ListCard(list *todov1.List) {
	<div id={ fmt.Sprintf("list-%s", list.Id) } class="group relative rounded-lg border border-border-subtle bg-surface p-5 transition-colors hover:border-border">
		<div class="flex items-start justify-between">
			<a
				href={ templ.SafeURL(fmt.Sprintf("/todo/%s", list.Id)) }
				class="font-semibold text-text-primary after:absolute after:inset-0"
			>
				{ list.Title }
			</a>
			if list.IsOwner {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/todo/%s/settings", list.Id)) }
					class="relative z-10 text-sm text-text-muted opacity-0 transition-opacity hover:text-text-secondary cursor-pointer group-hover:opacity-100"
				>
					Settings
				</a>
			} else {
				<button
					hx-post={ fmt.Sprintf("/todo/%s/leave", list.Id) }
					hx-target={ fmt.Sprintf("#list-%s", list.Id) }
					hx-swap="outerHTML"
					hx-confirm="Leave this list?"
					class="relative z-10 text-sm text-text-muted opacity-0 transition-opacity hover:text-delete cursor-pointer group-hover:opacity-100"
				>
					Leave
				</button>
			}
		</div>
		<p class="mt-3 text-sm text-text-muted">
			if !list.IsOwner {
				<span>by { list.OwnerName }</span>
				<span class="mx-1">&middot;</span>
			}
			if list.TotalItems == 0 {
				No items
			} else {
				{ fmt.Sprintf("%d/%d items", list.CompletedItems, list.TotalItems) }
			}
		</p>
	</div>
}
