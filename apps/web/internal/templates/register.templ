package templates

import "github.com/terjelafton/platform/apps/web/internal/templates/ui"

templ RegisterPage(errorMsg string) {
	@Layout("Register") {
		@ui.PageNarrow() {
			@ui.Card() {
				<h1 class="mb-6 text-2xl font-bold">Register</h1>
				@ui.AlertError(errorMsg)
				<form method="POST" action="/register">
					@ui.FormField("Name") {
						@ui.Input("text", "name", "Your name", true)
					}
					@ui.FormField("Email") {
						@ui.Input("email", "email", "you@example.com", true)
					}
					@ui.FormField("Password") {
						@ui.Input("password", "password", "Password (min 8 characters)", true)
					}
					@ui.FormField("Confirm Password") {
						@ui.Input("password", "password_confirm", "Confirm your password", true)
					}
					@ui.Button("Register")
				</form>
				<p class="mt-4 text-sm text-text-secondary">
					Already have an account? <a href="/login" class="text-link hover:underline">Login</a>
				</p>
			}
		}
	}
}
