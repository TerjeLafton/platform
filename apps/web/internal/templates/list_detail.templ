package templates

import (
	"fmt"

	"github.com/terjelafton/platform/apps/web/internal/templates/ui"
	todov1 "github.com/terjelafton/platform/libs/proto-stubs/todo/v1"
)

templ ListDetailPage(userID string, list *todov1.List, items []*todov1.Item) {
	@Layout(list.Title) {
		@ui.Navbar(userID) {
			<form method="POST" action="/logout">
				<button type="submit" class="text-sm text-text-secondary hover:text-text-primary cursor-pointer">Logout</button>
			</form>
		}
		@ui.PageWide() {
			<div class="mb-6">
				<a href="/todo" class="text-sm text-link hover:underline">&larr; Back to lists</a>
			</div>
			<div class="mb-6 flex items-center gap-3">
				<h1 class="text-2xl font-bold">{ list.Title }</h1>
				if list.IsOwner {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/todo/%s/settings", list.Id)) }
						class="text-sm text-text-muted hover:text-text-secondary"
					>
						Settings
					</a>
				}
			</div>
			if !list.IsOwner {
				<p class="mb-4 text-sm text-text-muted">
					Shared by { list.OwnerName }
				</p>
			}
			<form
				hx-post={ fmt.Sprintf("/todo/%s/items", list.Id) }
				hx-target="#items-list"
				hx-swap="beforeend"
				hx-on::after-request="if(event.detail.successful) this.reset()"
				class="mb-6 flex gap-2"
			>
				<input
					type="text"
					name="title"
					placeholder="Add a new item..."
					required
					class="flex-1 rounded border bg-input-bg border-input-border px-3 py-2 text-sm text-text-primary focus:border-brand focus:outline-none placeholder:text-text-muted"
				/>
				@ui.Button("Add Item")
			</form>
			<div hx-ext="sse" sse-connect={ fmt.Sprintf("/todo/%s/events", list.Id) }>
				<div id="items-list" class="space-y-2" sse-swap="item.created" hx-swap="beforeend">
					for _, item := range items {
						@ItemRow(item)
					}
				</div>
				<div sse-swap="item.toggled" hx-swap="none"></div>
				<div sse-swap="item.deleted" hx-swap="none"></div>
			</div>
			if len(items) == 0 {
				<p id="empty-state" class="py-8 text-center text-text-muted">No items yet. Add one above!</p>
			}
		}
	}
}

templ ItemRow(item *todov1.Item) {
	<div id={ fmt.Sprintf("item-%s", item.Id) } class="flex items-center gap-3 rounded border border-border-subtle bg-surface px-4 py-3">
		<input
			type="checkbox"
			if item.Completed {
				checked
			}
			hx-post={ fmt.Sprintf("/todo/items/%s/toggle", item.Id) }
			hx-target={ fmt.Sprintf("#item-%s", item.Id) }
			hx-swap="outerHTML"
			class="h-4 w-4 cursor-pointer accent-brand"
		/>
		<span
			class={
				"flex-1",
				templ.KV("line-through text-completed", item.Completed),
			}
		>
			{ item.Title }
		</span>
		<button
			hx-delete={ fmt.Sprintf("/todo/items/%s?list_id=%s", item.Id, item.ListId) }
			hx-target={ fmt.Sprintf("#item-%s", item.Id) }
			hx-swap="outerHTML"
			class="text-sm text-delete hover:text-delete-hover cursor-pointer"
		>
			Delete
		</button>
	</div>
}

templ ItemRowOOB(item *todov1.Item) {
	<div id={ fmt.Sprintf("item-%s", item.Id) } hx-swap-oob="outerHTML" class="flex items-center gap-3 rounded border border-border-subtle bg-surface px-4 py-3">
		<input
			type="checkbox"
			if item.Completed {
				checked
			}
			hx-post={ fmt.Sprintf("/todo/items/%s/toggle", item.Id) }
			hx-target={ fmt.Sprintf("#item-%s", item.Id) }
			hx-swap="outerHTML"
			class="h-4 w-4 cursor-pointer accent-brand"
		/>
		<span
			class={
				"flex-1",
				templ.KV("line-through text-completed", item.Completed),
			}
		>
			{ item.Title }
		</span>
		<button
			hx-delete={ fmt.Sprintf("/todo/items/%s?list_id=%s", item.Id, item.ListId) }
			hx-target={ fmt.Sprintf("#item-%s", item.Id) }
			hx-swap="outerHTML"
			class="text-sm text-delete hover:text-delete-hover cursor-pointer"
		>
			Delete
		</button>
	</div>
}
