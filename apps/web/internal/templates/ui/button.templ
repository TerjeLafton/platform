package ui

templ Button(text string) {
	<button type="submit" class="rounded bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 cursor-pointer">
		{ text }
	</button>
}

templ ButtonDanger(text string) {
	<button type="submit" class="rounded bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 cursor-pointer">
		{ text }
	</button>
}
